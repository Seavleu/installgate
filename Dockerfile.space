# syntax=docker/dockerfile:1
# Hugging Face Spaces (Docker). Local compose still uses Dockerfile + ui/Dockerfile.
FROM node:22-alpine AS ui-deps
WORKDIR /app
RUN corepack enable
COPY ui/package.json ui/pnpm-lock.yaml ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS ui-builder
WORKDIR /app
RUN corepack enable
COPY --from=ui-deps /app/node_modules ./node_modules
COPY ui/ ./
COPY contracts/contracts.ts /contracts/contracts.ts
RUN pnpm build

FROM python:3.11-slim AS api
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY contracts ./contracts
COPY engine ./engine
COPY validator ./validator
COPY router ./router
COPY remediate ./remediate
COPY mcp_server ./mcp_server
COPY eval ./eval
RUN uv sync --frozen --no-dev

FROM python:3.11-slim AS runtime
WORKDIR /app
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=api /app /app
COPY --from=ui-builder /app/.next/standalone /app/ui
COPY --from=ui-builder /app/.next/static /app/ui/.next/static
COPY space-start.sh /app/space-start.sh
RUN useradd --system --uid 1000 --home /app app \
  && mkdir -p /app/.cache \
  && chown -R app:app /app \
  && chmod +x /app/space-start.sh

USER app
ENV PATH="/app/.venv/bin:$PATH"
ENV CACHE_PATH=/app/.cache/installgate.sqlite
ENV API_URL=http://127.0.0.1:8000
ENV RATE_LIMIT_TRUST_PROXY=true
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=7860
EXPOSE 7860
CMD ["/app/space-start.sh"]
