NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=
# Optional overrides; otherwise resolved from GET /v1/models at startup
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
DAILY_SPEND_CAP_USD=5
# POST /check calls per visitor per minute. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=30
# Trust the rightmost X-Forwarded-For entry. docker-compose.yml sets true: caddy writes it.
RATE_LIMIT_TRUST_PROXY=false
ULTRA_ENABLED=true
CACHE_PATH=./.cache/installgate.sqlite
LOG_LEVEL=INFO
# docker compose only. :80 is plain HTTP for local runs. A domain (installgate.example.com)
# gets an automatic HTTPS certificate; its DNS A record must point at the server first.
SITE_ADDRESS=:80
# docker compose only. Host port for the API, bound to 127.0.0.1.
API_PORT=8000
